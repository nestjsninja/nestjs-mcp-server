{
  "name": "nestjs-mcp-server",
  "version": "1.0.0",
  "description": "Example project for the blog post: Building an MCP Server with NestJS",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "start:stdio": "node dist/main.stdio",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/**/*.spec.js\"",
    "test:watch": "tsc -p tsconfig.test.json --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/microservices": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@rekog/mcp-nest": "^2.0.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "^6.0.3"
  }
}
